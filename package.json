  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development chcp 65001 > nul && tsx watch src/server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:migrate:test": "cross-env DATABASE_URL=\"$DATABASE_URL_TEST\" npx prisma migrate dev",
    "prisma:push:test": "cross-env DATABASE_URL=\"$DATABASE_URL_TEST\" npx prisma db push",
    "prisma:reset:test": "cross-env DATABASE_URL=\"$DATABASE_URL_TEST\" npx prisma migrate reset --force"
  },
